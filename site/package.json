{
  "name": "smelt-site",
  "private": true,
  "version": "0.7.0",
  "description": "smelt project site — static, TypeScript + GSAP, no framework",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/bundle.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.13.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
