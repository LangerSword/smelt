  "candidate": "// Intentionally WRONG candidate: omits the count for single-character runs.\n// The oracle must catch this (spec: counts are always included).\nuse pyo3::prelude::*;\n\n#[pyfunction]\nfn rle_encode(text: &str) -> String {\n    let chars: Vec<char> = text.chars().collect();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < chars.len() {\n        let mut j = i;\n        while j < chars.len() && chars[j] == chars[i] {\n            j += 1;\n        }\n        out.push(chars[i]);\n        if j - i > 1 {\n            out.push_str(&(j - i).to_string());\n        }\n        i = j;\n    }\n    out\n}\n\n#[pymodule]\nfn smelt_ext(m: &Bound<'_, PyModule>) -> PyResult<()> {\n    m.add_function(wrap_pyfunction!(rle_encode, m)?)?;\n    Ok(())\n}\n"
